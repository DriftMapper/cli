{
  "name": "@driftmapper/cli",
  "version": "0.0.0",
  "description": "Driftmapper CLI — thin npm launcher for the bundled driftmapper binary",
  "bin": {
    "driftmapper": "bin/index.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "optionalDependencies": {
    "@driftmapper/cli-darwin-arm64": "0.0.0",
    "@driftmapper/cli-darwin-x64": "0.0.0",
    "@driftmapper/cli-linux-arm64": "0.0.0",
    "@driftmapper/cli-linux-x64": "0.0.0",
    "@driftmapper/cli-win32-arm64": "0.0.0",
    "@driftmapper/cli-win32-x64": "0.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:e2e": "bash test/e2e.sh"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DriftMapper/cli.git",
    "directory": "npm/wrapper"
  },
  "license": "Apache-2.0"
}
